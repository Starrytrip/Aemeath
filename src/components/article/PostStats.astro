---
import { Icon } from "astro-icon/components";

interface Props {
	path: string;
}

const { path } = Astro.props;
---

<div
  class="post-stats card-base px-5 py-3 mb-4 flex flex-wrap items-center justify-between gap-3"
  data-post-stats
  data-page={path}
>
  <div class="flex items-center gap-2 text-sm text-(--content-meta)">
    <Icon is:inline name="material-symbols:visibility-outline-rounded" class="text-xl" />
    <span>阅读</span>
    <span class="font-bold text-(--btn-content)" data-stat-views>…</span>
  </div>

  <button
    type="button"
    data-stat-like
    class="flex items-center gap-2 rounded-lg bg-(--btn-regular-bg) px-4 py-2 text-sm font-bold text-(--btn-content) transition active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed"
    aria-pressed="false"
  >
    <Icon
      is:inline
      name="material-symbols:favorite-outline-rounded"
      class="text-xl"
      data-stat-icon-off
    />
    <Icon
      is:inline
      name="material-symbols:favorite-rounded"
      class="text-xl hidden text-(--primary)"
      data-stat-icon-on
    />
    <span>点赞</span>
    <span data-stat-likes>…</span>
  </button>
</div>

<script>
  import { apiFetch, type PostStats } from "@/utils/api-client";

  const initStats = () => {
    const root = document.querySelector<HTMLElement>("[data-post-stats]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const page = root.dataset.page || window.location.pathname;
    const viewsEl = root.querySelector<HTMLElement>("[data-stat-views]");
    const likesEl = root.querySelector<HTMLElement>("[data-stat-likes]");
    const likeBtn = root.querySelector<HTMLButtonElement>("[data-stat-like]");
    const iconOff = root.querySelector<HTMLElement>("[data-stat-icon-off]");
    const iconOn = root.querySelector<HTMLElement>("[data-stat-icon-on]");

    const render = (stats: PostStats) => {
      if (viewsEl) viewsEl.textContent = String(stats.views);
      if (likesEl) likesEl.textContent = String(stats.likes);
      iconOff?.classList.toggle("hidden", stats.liked);
      iconOn?.classList.toggle("hidden", !stats.liked);
      likeBtn?.setAttribute("aria-pressed", String(stats.liked));
      if (likeBtn) likeBtn.title = stats.liked ? "取消点赞" : "点赞";
    };

    void (async () => {
      try {
        // 每次打开文章记一次阅读量，同时拿到最新点赞状态
        const stats = await apiFetch<PostStats>("/stats/views", {
          method: "POST",
          body: JSON.stringify({ page }),
        });
        render(stats);
      } catch {
        if (viewsEl) viewsEl.textContent = "-";
        if (likesEl) likesEl.textContent = "-";
      }
    })();

    likeBtn?.addEventListener("click", async () => {
      likeBtn.disabled = true;
      try {
        const stats = await apiFetch<PostStats>("/stats/like", {
          method: "POST",
          body: JSON.stringify({ page }),
        });
        render(stats);
      } catch {
        // 失败时保持原状态
      } finally {
        likeBtn.disabled = false;
      }
    });
  };

  initStats();
  document.addEventListener("astro:page-load", initStats);
  document.addEventListener("yukina:article-loaded", initStats);
</script>
