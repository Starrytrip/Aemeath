---
import type {WidgetComponentConfig} from "@/types/config";
import Profile from "@/components/widget/Profile.astro";
import Announcement from "@/components/widget/Announcement.astro";
import Categories from "@/components/widget/Categories.astro";
import Tags from "@/components/widget/Tags.astro";
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Calendar from "@/components/widget/Calendar.astro";
import Music from "@/components/widget/Music.astro";
import SiteInfo from "@/components/widget/SiteInfo.astro";
import TimeGreeting from "@/components/widget/TimeGreeting.astro";
import QuoteOfTheDay from "@/components/widget/QuoteOfTheDay.astro";
import ScheduleProgress from "@/components/widget/ScheduleProgress.astro";
import Advertisement from "@/components/widget/Advertisement.astro";
import {sidebarLayoutConfig} from "@/config";
const map={profile:Profile,announcement:Announcement,categories:Categories,tags:Tags,sidebarToc:SidebarTOC,stats:SiteStats,calendar:Calendar,music:Music,siteInfo:SiteInfo,timeGreeting:TimeGreeting,quoteOfTheDay:QuoteOfTheDay,scheduleProgress:ScheduleProgress,advertisement:Advertisement};
const {side="left",class:className,headings=[]}=Astro.props;
const entries=side==="right"?sidebarLayoutConfig.rightComponents:side==="bottom"?sidebarLayoutConfig.mobileBottomComponents:sidebarLayoutConfig.leftComponents;
const isPost=Astro.url.pathname.startsWith("/posts/")||Astro.url.pathname.startsWith("/reader/");
---
<div id={`${side}-sidebar`} class:list={[className,"sidebar-card-decor flex flex-col w-full gap-4"]}>
{["top","sticky"].map(position=><div data-managed-column={side} data-managed-position={position} class:list={["flex flex-col gap-4",position==="sticky"&&"sticky top-4"]}>
{entries.filter(c=>("position" in c?c.position:"top")===position).map(c=>{const Component=map[c.type];const visible=c.enable&&(!isPost||!("showOnPostPage" in c)||c.showOnPostPage!==false)&&(isPost||!("hideOnNonPostPage" in c)||!c.hideOnNonPostPage);return Component&&<div data-managed-widget={side==="bottom"?undefined:c.type} style={visible?undefined:"display:none"}><Component widgetConfig={{...c,position:(c as WidgetComponentConfig).position || "top"}} headings={headings}/></div>;})}
</div>)}
</div>
