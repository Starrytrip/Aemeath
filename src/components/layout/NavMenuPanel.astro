---
import ManagedNavigation from "./ManagedNavigation.svelte";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const mobileProfileName = siteConfig.title;
---

<div id="nav-menu-panel" class="mobile-nav float-panel-closed transition-all fixed" aria-hidden="true">
	<button class="mobile-bg" type="button" aria-label="关闭导航菜单" data-mobile-menu-close></button>
	<aside class="mobile-content" role="dialog" aria-modal="true" aria-label="网站导航" tabindex="-1">
		<header class="mobile-nav-header">
			<a class="mobile-profile" href={url("/about/")} aria-label={`${mobileProfileName}个人主页`} data-mobile-menu-close>
				<ImageWrapper
					src={profileConfig.avatar || ""}
					alt={`${mobileProfileName}头像`}
					class="mobile-profile-avatar"
					loading="eager"
					fetchpriority="high"
					widths={[160]}
					sizes="88px"
				/>
				<strong class="mobile-profile-name">{mobileProfileName}</strong>
				{profileConfig.bio && <span class="mobile-profile-bio">{profileConfig.bio}</span>}
			</a>
			<button class="mobile-nav-close" type="button" aria-label="关闭导航菜单" data-mobile-menu-close>
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
		</header>

		{profileConfig.links.length > 0 && (
			<div class="mobile-profile-links" aria-label="个人社交链接">
				<a
					class="mobile-profile-social"
					href={url("/rss.xml")}
					aria-label="RSS订阅"
					title="RSS订阅"
				>
					<Icon is:inline name="material-symbols:rss-feed-rounded" aria-hidden="true" />
				</a>
				{profileConfig.links.map((link) =>
					link.url.startsWith("copy:") ? (
						<button
							type="button"
							class="mobile-profile-social"
							aria-label={link.name}
							title={link.name}
							data-mobile-social-copy
							data-copy-value={link.url.slice(5)}
						>
							<Icon is:inline name={link.icon} aria-hidden="true" />
						</button>
					) : (
						<a
							class="mobile-profile-social"
							href={link.url}
							aria-label={link.name}
							title={link.name}
							target={link.url.startsWith("mailto:") ? undefined : "_blank"}
							rel="me noopener noreferrer"
						>
							<Icon is:inline name={link.icon} aria-hidden="true" />
						</a>
					),
				)}
			</div>
		)}

		<nav class="mobile-links" aria-label="移动端主导航">
<ManagedNavigation mobile client:load />
		</nav>
		<div class="mobile-footer">
			<span class="mobile-prompt">{siteConfig.title} · {siteConfig.subtitle}</span>
		</div>
	</aside>
</div>

<script>
	// Swup reruns this script after navigation; replace the previous listeners.
	const menuWindow = window as Window & {
		__fireflyMobileMenuEvents?: AbortController;
	};
	menuWindow.__fireflyMobileMenuEvents?.abort();
	const menuEvents = new AbortController();
	menuWindow.__fireflyMobileMenuEvents = menuEvents;

	function closeMobileMenu() {
		const setMenuOpen = (window as Window & {
			__fireflySetMobileMenuOpen?: (open: boolean) => void;
		}).__fireflySetMobileMenuOpen;
		if (setMenuOpen) {
			setMenuOpen(false);
			return;
		}

		const menuPanel = document.getElementById("nav-menu-panel");
		const menuBtn = document.getElementById("nav-menu-switch");
		menuPanel?.classList.add("float-panel-closed");
		menuPanel?.classList.remove("active");
		menuPanel?.setAttribute("aria-hidden", "true");
		document.getElementById("top-row")?.classList.remove("mobile-nav-open");
		menuBtn?.classList.remove("active");
		menuBtn?.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
	}

	document.addEventListener("click", function(event) {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const groupButton = target.closest<HTMLButtonElement>(".mobile-group-title");
		if (groupButton) {
			const group = groupButton.closest<HTMLElement>(".mobile-nav-group");
			if (!group) return;
			const expanded = group.dataset.open === "true";
			const nextExpanded = !expanded;
			group.dataset.open = String(nextExpanded);
			groupButton.setAttribute("aria-expanded", String(nextExpanded));
			const panel = group.querySelector<HTMLElement>(".mobile-group-panel");
			panel?.toggleAttribute("inert", !nextExpanded);
			if (nextExpanded) panel?.removeAttribute("aria-hidden");
			else panel?.setAttribute("aria-hidden", "true");
			return;
		}

		if (target.closest(".mobile-link, [data-mobile-menu-close]")) closeMobileMenu();

		const copyButton = target.closest<HTMLButtonElement>("[data-mobile-social-copy]");
		if (!copyButton) return;

		const value = copyButton.getAttribute("data-copy-value");
		if (!value) return;

		const copy = async () => {
			let copied = false;
			try {
				await navigator.clipboard.writeText(value);
				copied = true;
			} catch {
				// Clipboard access can be denied or unavailable outside a secure context.
			}

			const label = copyButton.getAttribute("title") || copyButton.getAttribute("aria-label") || "链接";
			if (copied) copyButton.dataset.copied = "true";
			copyButton.title = copied ? `${label}已复制` : "复制失败，请手动复制";
			copyButton.setAttribute("aria-label", copyButton.title);
			window.setTimeout(() => {
				delete copyButton.dataset.copied;
				copyButton.title = label;
				copyButton.setAttribute("aria-label", label);
			}, 1400);
		};

		void copy();
	}, { signal: menuEvents.signal });

	document.addEventListener("keydown", function(event) {
		if (event.key === "Escape") closeMobileMenu();
	}, { signal: menuEvents.signal });
</script>
