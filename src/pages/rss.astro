---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import BackendPostList from "@/components/pages/BackendPostList.svelte";
---
<MainGridLayout title="RSS 订阅"><section class="card-base mb-4 p-6"><h1 class="text-2xl font-bold">RSS 订阅</h1><p class="mt-4">订阅后可在阅读器中查看本站最新发布的文章。</p><a class="btn-plain mt-4 inline-block rounded-xl p-3" href="/rss.xml">订阅本站 RSS →</a></section><BackendPostList client:load /></MainGridLayout>
