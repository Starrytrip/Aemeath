---
import ManagedGallery from "@/components/pages/gallery/ManagedGallery.svelte";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.gallery) return Astro.redirect("/404/");
---
<MainGridLayout title="相册" description="收藏沿途风景，记录生活里的片刻。">
  <ManagedGallery client:load />
</MainGridLayout>
