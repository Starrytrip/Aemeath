---
import * as path from "node:path";
import PublishedArticles from "@/components/admin/PublishedArticles.svelte";
import PostStats from "@/components/article/PostStats.astro";
import Comment from "@/components/comment/index.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { removeFileExtension } from "@/utils/url-utils";

export async function getStaticPaths() {
	return (await getSortedPosts()).map((entry) => {
		if (!entry.filePath) throw new Error(`文章缺少来源路径：${entry.id}`);
		const relative = path.relative(path.resolve("src/content/posts"), path.resolve(entry.filePath)).replaceAll("\\", "/");
		return {
			params: { slug: removeFileExtension(entry.id) },
			props: {
				sourceKey: `astro-posts:${relative}`,
				pagePath: `/posts/${removeFileExtension(entry.id)}`,
				comments: entry.data.comment && !entry.data.password,
			},
		};
	});
}
const { sourceKey, pagePath, comments } = Astro.props;
---

<MainGridLayout title="文章阅读" setOGTypeArticle={true}>
	<PublishedArticles reader sourceKey={sourceKey} client:only="svelte">
		<PostStats path={pagePath} />
		{comments && <Comment customPath={pagePath} />}
	</PublishedArticles>
</MainGridLayout>
